---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import siteConfig from '../data/site-config';
import { getCollection } from 'astro:content';
import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    image?: { src: string; alt?: string };
    pageType?: 'website' | 'article';
    keywords?: string;
    author?: string;
    publishedTime?: string;
    modifiedTime?: string;
    // NEW: i18n support
    lang?: 'ru' | 'en';
};

const {
    description = siteConfig.description,
    image = siteConfig.image,
    pageType = 'website',
    keywords,
    author = 'Ivan Tyrtyshnyi',
    publishedTime,
    modifiedTime,
    // NEW: language detection
    lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'ru'
} = Astro.props;

const title = Astro.props.title ?? siteConfig.title;
const resolvedImage = image?.src
    ? {
          src: new URL(image.src, Astro.site).toString(),
          alt: image.alt
      }
    : undefined;
const canonicalURL = new URL(Astro.request.url, Astro.site);

function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    if (hasQueryParams) {
        return path.replace(/\/?$/, '');
    }
    return path.replace(/\/?$/, '/');
}

// B-01a: only emit hreflang for paths generated in BOTH languages.
// Different RU/EN article slugs require explicit editorial mapping (B-01b).
const pairedStaticPaths = ['/', '/about/', '/blog/', '/cases/', '/contact/', '/faq/', '/projects/', '/selection/', '/terms/'];
const availableRoutes = new Set<string>();
for (const path of pairedStaticPaths) {
    availableRoutes.add(path);
    availableRoutes.add(path === '/' ? '/en/' : `/en${path}`);
}

const collections = await Promise.all([
    getCollection('blog'),
    getCollection('cases'),
    getCollection('projects')
]);
const sections = ['blog', 'cases', 'projects'] as const;

for (let i = 0; i < collections.length; i++) {
    const section = sections[i];
    const entries = collections[i];
    for (const entry of entries) {
        const english = entry.id.startsWith('en/');
        const id = english ? entry.id.slice(3) : entry.id;
        availableRoutes.add(`${english ? '/en' : ''}/${section}/${id}/`);
    }
    // All three listing routes paginate at 8 entries per page.
    for (const english of [false, true]) {
        const count = entries.filter(({ id }) => id.startsWith('en/') === english).length;
        for (let page = 2; page <= Math.ceil(count / 8); page++) {
            availableRoutes.add(`${english ? '/en' : ''}/${section}/${page}/`);
        }
    }
}

// B-01b: editorially verified translated articles with different slugs.
// Never infer translations from similar titles or the order of publication.
const explicitTranslationPairs = new Map<string, string>([
    ['/blog/short-term-rentals-dubai-2025/', '/en/blog/post-2/'],
    ['/blog/golden-visa-uae-real-estate-2025/', '/en/blog/post-3/'],
    ['/blog/dubai-2026-market-maturity/', '/en/blog/post-5/'],
    ['/blog/etihad-rail-2026-railway-arbitrage/', '/en/blog/post-6/'],
    ['/blog/price-of-fear-capital-institutions/', '/en/blog/post-7/'],
    ['/blog/dubai-law-4-2026-subarenda/', '/en/blog/post-9/'],
    ['/blog/ai-uae-amazon-aws-fintech/', '/en/blog/post-10/'],
    ['/blog/dubai-5-3-mlrd-920-mlrd-rezervov/', '/en/blog/post-11/'],
    ['/blog/korrekciya-rynka-oae-2026-strukturnaya-ustojchivost/', '/en/blog/post-12/'],
    ['/blog/dubai-maritime-city-investicii-2026/', '/en/blog/post-13/'],
    ['/blog/dubai-2026-arendatory-ipoteka/', '/en/blog/post-14/'],
    ['/blog/dubai-viza-rezidenstvo-2026-novye-pravila/', '/en/blog/post-15/'],
    ['/blog/dubai-upal-na-50-dannye-dld-2026/', '/en/blog/post-16/'],
    ['/blog/hotel-apartment-vs-residential-dubai-2026/', '/en/blog/post-17/'],
    ['/blog/ofis-dubai-2026-konec-virtualnogo-stola/', '/en/blog/post-18/'],
    ['/blog/tyazhelaya-promyshlennost-logistika-oae-2026-2028/', '/en/blog/post-19/'],
    ['/blog/dubai-rynok-nedvizhimosti-korrekciya-sprosa-iyun-2026/', '/en/blog/post-20/'],
    ['/blog/blackstone-difc-dubai-novyj-cikl-rynka-nedvizhimosti/', '/en/blog/post-21/'],
    ['/blog/kommercheskaya-promyshlennaya-nedvizhimost-dubai-q2-2026/', '/en/blog/post-22/'],
    ['/blog/dubai-958-mlrd-aed-ultra-prime-gotovaya-vtorichka-avgust-2026/', '/en/blog/post-23/'],
    ['/blog/industrialnaya-nedvizhimost-oae-180-mlrd-aed-goszakazov/', '/en/blog/post-24/'],
    ['/blog/nedvizhimost-dubaya-matematika-puzyrya-2026/', '/en/blog/post-25/'],
    ['/blog/zaveshchanie-v-oae-dengi-nedvizhimost-opeka-detej/', '/en/blog/post-26/']
]);
const englishToRussian = new Map(
    Array.from(explicitTranslationPairs, ([ru, en]) => [en, ru])
);

function generateHreflangUrls(currentPath: string) {
    const baseUrl = siteConfig.website;
    const normalized = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
    const ruPath = englishToRussian.get(normalized)
        ?? (normalized.replace(/^\/en(?=\/)/, '') || '/');
    const enPath = explicitTranslationPairs.get(ruPath)
        ?? (ruPath === '/' ? '/en/' : `/en${ruPath}`);

    if (!availableRoutes.has(ruPath) || !availableRoutes.has(enPath)) return [];

    return [
        { lang: 'ru', url: baseUrl + ruPath },
        { lang: 'en', url: baseUrl + enPath },
        { lang: 'x-default', url: baseUrl + ruPath }
    ];
}

const currentPath = Astro.url.pathname;
const hreflangUrls = generateHreflangUrls(currentPath);

// NEW: Dynamic locale based on language
const ogLocale = lang === 'en' ? 'en_US' : 'ru_RU';

// Structured data for better SEO
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': pageType === 'article' ? 'Article' : 'WebSite',
    name: title,
    description: description,
    url: formatCanonicalURL(canonicalURL),
    ...(resolvedImage?.src && { image: resolvedImage.src }),
    ...(author && { author: { '@id': 'https://www.ivandubai.xyz/#person' } }),
    ...(publishedTime && { datePublished: publishedTime }),
    ...(modifiedTime && { dateModified: modifiedTime })
};
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content="Ivan from Dubai" />

<!-- Fonts -->
<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin="anonymous" />

<!-- Low Priority Global Metadata -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />
<link rel="alternate" type="application/json" href="/llm.json" />

<!-- NEW: hreflang attributes for multilingual SEO -->
{hreflangUrls.map(({ lang: hrefLang, url }) => <link rel="alternate" hreflang={hrefLang} href={url} />)}

<!-- Page Metadata -->
<link rel="canonical" href={formatCanonicalURL(canonicalURL)} />
<meta name="description" content={description} />
{author && <meta name="author" content={author} />}
{keywords && <meta name="keywords" content={keywords} />}

<!-- SEO Enhancements -->
<meta name="theme-color" content="#F9F9F3" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={formatCanonicalURL(canonicalURL)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.title} />
<!-- NEW: Dynamic locale based on language -->
<meta property="og:locale" content={ogLocale} />
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}
{resolvedImage?.src && <meta property="og:image:width" content="1200" />}
{resolvedImage?.src && <meta property="og:image:height" content="630" />}
{pageType === 'article' && author && <meta property="article:author" content={author} />}
{pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{pageType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- X/Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={formatCanonicalURL(canonicalURL)} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{resolvedImage?.src && <meta property="twitter:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta name="twitter:image:alt" content={resolvedImage?.alt} />}

<!-- Geographic targeting for Dubai -->
<meta name="geo.region" content="AE-DU" />
<meta name="geo.placename" content="Dubai" />
<meta name="geo.position" content="25.276987;55.296249" />
<meta name="ICBM" content="25.276987, 55.296249" />

<!-- Structured Data for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- AI/LLM Reading Context -->
<meta name="ai:description" content="Ivan Tyrtyshnyi - UAE real estate consultant using AI-driven rhythm-based property matching. Helps expats find emotionally aligned properties in Dubai." />
<meta name="ai:approach" content="lifestyle-first matching, anti-FOMO guidance, willing to recommend 'wait' or 'decline'" />
<meta name="ai:differentiator" content="Uses AI to filter emotional mismatch + recommends saying NO when property doesn't match client's life rhythm" />
<meta name="ai:target" content="expats seeking lifestyle fit in UAE coastal areas (Palm Jumeirah, Dubai Islands, Saadiyat)" />
<meta name="ai:method" content="AI-integrated workflow for rhythm analysis and noise filtering" />

<!-- JSON-LD RealEstateAgent Schema for AI Agents -->
<script type="application/ld+json" set:html={JSON.stringify(siteConfig.structuredData)} />
